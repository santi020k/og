{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "env": ["PUBLIC_SITE_URL", "PUBLIC_TURNSTILE_SITE_KEY"],
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "public/og/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "ci:web": {
      "env": ["PUBLIC_SITE_URL", "PUBLIC_TURNSTILE_SITE_KEY"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "coverage/**", "public/og/**"]
    },
    "validate": {
      "env": ["PUBLIC_SITE_URL", "PUBLIC_TURNSTILE_SITE_KEY"],
      "dependsOn": ["^validate"],
      "outputs": ["dist/**", "coverage/**", "public/og/**"]
    }
  }
}
