{
  "name": "santi020k-og-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:spell": "cspell \"**\" --gitignore --cache --show-suggestions --show-context",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm run lint:spell && turbo run validate"
  },
  "devDependencies": {
    "cspell": "^10.0.1",
    "turbo": "^2.10.11"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.32.1"
}
