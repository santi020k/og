{
  "name": "santi020k-og-workspace",
  "private": true,
  "description": "Renderer-agnostic Open Graph image generation with Sharp and Satori adapters.",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo",
    "deploy:web": "pnpm run build && wrangler pages deploy dist --cwd apps/web --project-name=santi020k-og --branch=main",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:spell": "cspell \"**\" --gitignore --cache --show-suggestions --show-context",
    "test": "turbo run test",
    "test:consumers": "pnpm --filter @santi020k/og run test:consumers",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm run lint:spell && turbo run validate",
    "commit": "commitprompt",
    "hooks:install": "quality hooks install"
  },
  "devDependencies": {
    "@santi020k/commitprompt": "1.1.0",
    "cspell": "^10.3.6",
    "turbo": "^2.11.7",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "satori>fflate": "0.7.5",
      "miniflare>sharp": "0.35.5"
    }
  }
}
