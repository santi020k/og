---
import { Icon, ThemeToggle } from '@santi020k/lumen-astro'

interface Props {
  active?: 'checker' | 'docs' | 'home'
}

const { active = 'home' } = Astro.props
const links = [
  { href: '/#examples', label: 'Examples', key: 'examples' },
  { href: '/checker', label: 'Checker', key: 'checker' },
  { href: '/docs', label: 'Docs', key: 'docs' }
]
---

<header class="site-header" data-home={active === 'home'}>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="@santi020k/og home">
      <img src="/icon.svg" width="34" height="34" alt="" />
      <span>@santi020k/og</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map(link => <a href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="header-utilities">
      <ThemeToggle class="theme-control" />
      <a class="github-link" href="https://github.com/santi020k/og" aria-label="View @santi020k/og on GitHub"><Icon name="github" /><span>Source</span><Icon name="arrow-up-right" /></a>
    </div>
    <details class="mobile-nav">
      <summary aria-label="Open navigation"><Icon name="menu" /><span>Menu</span></summary>
      <nav aria-label="Mobile navigation">
        {links.map((link, index) => <a href={link.href} aria-current={active === link.key ? 'page' : undefined}><span aria-hidden="true">0{index + 1}</span>{link.label}<Icon name="arrow-up-right" /></a>)}
        <a href="https://github.com/santi020k/og"><span aria-hidden="true">04</span>Source on GitHub<Icon name="arrow-up-right" /></a>
      </nav>
    </details>
  </div>
</header>

<script>
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return
    const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav[open]')
    if (menu) {
      menu.open = false
      menu.querySelector<HTMLElement>('summary')?.focus()
    }
  })
  document.addEventListener('click', event => {
    if (!(event.target instanceof Element)) return
    if (event.target.closest('.mobile-nav a')) {
      const menu = event.target.closest('details')
      if (menu instanceof HTMLDetailsElement) menu.open = false
    }
  })
</script>
