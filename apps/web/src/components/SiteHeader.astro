  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="@santi020k/og home">
      <img src="/icon.svg" width="34" height="34" alt="" />
      <span>@santi020k/og</span>
    </a>
    <nav aria-label="Primary navigation">
      <a class="nav-features" href="/#features">Features</a>
      <a href="/docs" aria-current={active === 'docs' ? 'page' : undefined}>Docs</a>
      <a class="github-link" href="https://github.com/santi020k/og">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.94 10.94 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
