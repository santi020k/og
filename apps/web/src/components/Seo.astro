---
import MetadataHead from '@santi020k/og/astro/head'
import { definePageMetadata } from '@santi020k/og/metadata'
import { defineSchema, serializeJsonLd } from '@santi020k/og/schema'

interface Props {
  description: string
  image?: string
  title: string
}

const { description, image = '/og/default.webp', title } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)

const page = definePageMetadata({
  description,
  image: {
    alt: '@santi020k/og package card',
    height: 630,
    output: image.replace(/^\/og\//u, ''),
    width: 1200
  },
  pathname: canonical.pathname,
  title
})

const site = {
  locale: 'en_US',
  publicImagePath: '/og',
  siteName: '@santi020k/og',
  siteUrl: Astro.site ?? Astro.url.origin,
  titleTemplate: title === '@santi020k/og' ? '%s — Open Graph image generation' : '%s — @santi020k/og'
}

const structuredData = defineSchema({
  '@type': 'SoftwareSourceCode',
  codeRepository: 'https://github.com/santi020k/og',
  description,
  license: 'https://opensource.org/license/mit',
  name: '@santi020k/og',
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'Node.js',
  url: canonical.href
})
---

<MetadataHead {page} {site} />
<meta name="author" content="Santiago Molina" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#07110e" />
<meta name="color-scheme" content="dark" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<script type="application/ld+json" set:html={serializeJsonLd(structuredData)} is:inline />
