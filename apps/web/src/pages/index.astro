---
import BaseLayout from '../layouts/BaseLayout.astro'
import PresetGallery from '../components/PresetGallery.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'

const description = 'Generate polished, deterministic Open Graph images from reusable presets or your own renderer. Built for Astro, Next.js, and plain Node.js.'

const features = [
  {
    eyebrow: 'Start with a preset',
    title: 'Useful before customization',
    body: 'Choose simple, article, docs, or product. Add your copy, palette, logo, and image without owning a renderer.'
  },
  {
    eyebrow: 'Build only what changed',
    title: 'Content-aware caching',
    body: 'Card data, dimensions, configuration, templates, fonts, and declared source files all participate in deterministic fingerprints.'
  },
  {
    eyebrow: 'Keep the escape hatch',
    title: 'Custom when it matters',
    body: 'Move to Sharp, Satori, or encoded output only when your project needs a genuinely custom composition.'
  }
]

const steps = [
  ['01', 'Describe the page', 'Provide a title, description, badge, route, and optional image—or collect them from Astro content.'],
  ['02', 'Choose the visual', 'Use a built-in preset, customize its brand and theme, or bring a Sharp or Satori renderer.'],
  ['03', 'Generate with confidence', 'Build in parallel, skip unchanged cards, and verify committed output without mutating CI.']
]
---

<BaseLayout title="@santi020k/og" description={description}>
  <SiteHeader />

  <main id="content">
    <section class="hero shell">
      <div class="hero-copy">
        <div class="pill"><span></span> Presets when you want them. Renderers when you need them.</div>
        <h1>Open Graph images,<br /><em>ready to be seen.</em></h1>
        <p>{description}</p>
        <div class="hero-actions">
          <div class="install" aria-label="Install command">
            <span aria-hidden="true">$</span>
            <code>pnpm add -D @santi020k/og</code>
            <button type="button" data-copy="pnpm add -D @santi020k/og" aria-label="Copy install command">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2M5 8h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z"/></svg>
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <a class="text-link" href="/docs#quick-start">Get started <span>→</span></a>
        </div>
        <div class="compatibility" aria-label="Compatible technologies">
          <span>Works anywhere Node.js runs</span>
          <ul>
            <li>Astro</li>
            <li>Next.js</li>
            <li>Sharp</li>
            <li>Satori</li>
          </ul>
        </div>
      </div>

      <div class="hero-visual" aria-label="Generated product preset example">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <img
          class="hero-preview"
          src="/og/presets/product.webp"
          width="1200"
          height="630"
          alt="Product preset generated by @santi020k/og"
        />
        <span class="format format-svg">SVG</span>
        <span class="format format-webp">WebP</span>
        <span class="format format-png">PNG</span>
      </div>
    </section>

    <section class="proof">
      <div class="shell proof-grid">
        <div><strong>5</strong><span>output formats</span></div>
        <div><strong>0</strong><span>framework runtime</span></div>
        <div><strong>4</strong><span>ready-made presets</span></div>
        <p>Use a visual default today and keep the freedom to replace every pixel tomorrow.</p>
      </div>
    </section>

    <section class="examples" id="examples">
      <div class="shell">
        <div class="section-heading">
          <span class="kicker">Real generated output</span>
          <h2>Pick a starting point.<br /><em>Make it yours.</em></h2>
          <p>These are not website mockups. Every image below is generated during this documentation site’s build using the public v0.7 API.</p>
        </div>
        <PresetGallery />
        <div class="examples-note">
          <span>All examples: <code>1200 × 630 WebP</code></span>
          <a class="text-link" href="/docs#presets">See the code behind them <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="features shell" id="features">
      <div class="section-heading">
        <span class="kicker">The useful machinery</span>
        <h2>Own the creative.<br /><em>Delegate the repetitive.</em></h2>
        <p>Everything a production image pipeline needs, without moving your content or visual language into a framework.</p>
      </div>
      <div class="feature-grid">
        {features.map((feature, index) => (
          <article class="feature-card">
            <span class="feature-number">0{index + 1}</span>
            <div class:list={['feature-icon', `feature-icon-${index + 1}`]} aria-hidden="true">
              {index === 0 && <><span></span><span></span><span></span></>}
              {index === 1 && <><i></i><b></b></>}
              {index === 2 && <><span></span><i>✓</i></>}
            </div>
            <span class="eyebrow">{feature.eyebrow}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="workflow">
      <div class="shell workflow-grid">
        <div class="section-heading compact">
          <span class="kicker">A boringly good build step</span>
          <h2>From content to card<br /><em>in three moves.</em></h2>
        </div>
        <ol>
          {steps.map(([number, title, body]) => (
            <li>
              <span>{number}</span>
              <div><h3>{title}</h3><p>{body}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="cta shell">
      <img src="/icon.svg" width="54" height="54" alt="" />
      <span class="kicker">Ready when your content is</span>
      <h2>Make every link<br /><em>look intentional.</em></h2>
      <p>Start with a visual preset, connect your routes or content, then customize only what makes your product distinct.</p>
      <div class="cta-actions">
        <a class="button" href="https://www.npmjs.com/package/@santi020k/og">View on npm <span>↗</span></a>
        <a class="button secondary" href="https://github.com/santi020k/og">Browse the source <span>→</span></a>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    const button = document.querySelector<HTMLButtonElement>('[data-copy]')

    button?.addEventListener('click', async () => {
      const command = button.dataset.copy
      if (!command) return
      await navigator.clipboard.writeText(command)
      const label = button.querySelector('.copy-label')
      if (label) label.textContent = 'Copied'
      window.setTimeout(() => {
        if (label) label.textContent = 'Copy'
      }, 1600)
    })
  </script>
</BaseLayout>
