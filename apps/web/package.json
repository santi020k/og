{
  "name": "@santi020k/og-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run generate:brand && pnpm run generate:og && astro check && astro build && pnpm run audit:site && pnpm run build:functions",
    "build:functions": "wrangler pages functions build functions --outdir .wrangler/functions --project-directory .",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm run generate:og && astro dev",
    "generate:brand": "node scripts/generate-brand.mjs",
    "generate:og": "node ../../packages/og/dist/cli.js generate",
    "lint": "astro check",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "astro check",
    "validate": "pnpm run clean && pnpm run build",
    "audit:site": "node ../../packages/og/dist/cli.js audit --config og.audit.config.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@santi020k/lumen-astro": "^4.0.0",
    "@santi020k/og": "workspace:*",
    "@santi020k/theme": "^2.0.1",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
