{
  "name": "@santi020k/og",
  "version": "1.0.0",
  "description": "Generate deterministic Open Graph images with reusable presets or project-owned renderers.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./astro/head": "./astro/MetadataHead.astro",
    "./astro/starlight": "./astro/StarlightMetadataHead.astro",
    "./audit": {
      "types": "./dist/audit.d.ts",
      "default": "./dist/audit.js"
    },
    "./audit/config": {
      "types": "./dist/audit-config.d.ts",
      "default": "./dist/audit-config.js"
    },
    "./audit/rules": {
      "types": "./dist/audit-rules.d.ts",
      "default": "./dist/audit-rules.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "default": "./dist/inspect.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./metadata/html": {
      "types": "./dist/metadata-html.d.ts",
      "default": "./dist/metadata-html.js"
    },
    "./metadata/next": {
      "types": "./dist/metadata-next.d.ts",
      "default": "./dist/metadata-next.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./sharp": {
      "types": "./dist/renderers/sharp.d.ts",
      "default": "./dist/renderers/sharp.js"
    },
    "./satori": {
      "types": "./dist/renderers/satori.d.ts",
      "default": "./dist/renderers/satori.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./site": {
      "types": "./dist/site.d.ts",
      "default": "./dist/site.js"
    }
  },
  "bin": {
    "santi-og": "./dist/cli.js"
  },
  "files": [
    "dist",
    "astro",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "STABILITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --cache --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --cache --fix --no-warn-ignored --max-warnings=0",
    "lint:spell": "cspell \"**\" --gitignore --cache --show-suggestions --show-context",
    "test": "vitest run && node --test tests/*.test.mjs",
    "test:consumers": "node scripts/test-consumers.mjs",
    "test:coverage": "vitest run --coverage && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:pack": "publint",
    "validate": "pnpm run clean && pnpm run build && pnpm run typecheck && pnpm run test:coverage && pnpm run lint && pnpm run lint:spell && pnpm run check:pack",
    "prepack": "pnpm run validate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "fontkit": "^2.0.4",
    "satori": "^0.33.4",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@santi020k/eslint-config-basic": "^3.5.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "astro-eslint-parser": "^3.1.0",
    "cspell": "^10.1.0",
    "eslint": "^10.9.0",
    "oxlint": "1.80.0",
    "publint": "^0.3.24",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.32.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/og.git",
    "directory": "packages/og"
  },
  "homepage": "https://og.santi020k.com",
  "bugs": {
    "url": "https://github.com/santi020k/og/issues"
  },
  "keywords": [
    "open-graph",
    "og-image",
    "social-image",
    "satori",
    "sharp",
    "astro",
    "seo"
  ],
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "license": "MIT"
}
